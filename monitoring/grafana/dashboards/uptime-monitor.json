{
  "title": "Uptime Monitor",
  "uid": "uptime-monitor",
  "panels": [
    {
      "title": "Backend & Frontend Uptime",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
          "type": "json",
          "source": "url",
          "url": "https://cdn.jsdelivr.net/gh/victor-2026/qa-automation-playwright@main/monitoring/metrics/uptime.json",
          "root_selector": ""
        }
      ],
      "transformations": [
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              { "targetField": "timestamp", "conversion": { "id": "stringToTime", "config": { "dateFormat": "iso" } } }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "timestamp": "Time",
              "backend_status": "Backend",
              "frontend_status": "Frontend"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "up": { "text": "UP", "color": "green" }, "down": { "text": "DOWN", "color": "red" } } }
          ]
        }
      }
    },
    {
      "title": "Backend Status (Latest)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
          "type": "json",
          "source": "url",
          "url": "https://cdn.jsdelivr.net/gh/victor-2026/qa-automation-playwright@main/monitoring/metrics/uptime.json",
          "root_selector": ""
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": { "sort": [{ "field": "timestamp", "desc": true }] }
        },
        { "id": "limit", "options": { "limitField": 1 } },
        { "id": "organize", "options": { "excludeByName": { "timestamp": true, "frontend_status": true }, "renameByName": { "backend_status": "Backend" } } }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "up": { "text": "UP", "color": "green" }, "down": { "text": "DOWN", "color": "red" } } }
          ]
        }
      }
    },
    {
      "title": "Frontend Status (Latest)",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 4 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "infinity" },
          "type": "json",
          "source": "url",
          "url": "https://cdn.jsdelivr.net/gh/victor-2026/qa-automation-playwright@main/monitoring/metrics/uptime.json",
          "root_selector": ""
        }
      ],
      "transformations": [
        {
          "id": "sortBy",
          "options": { "sort": [{ "field": "timestamp", "desc": true }] }
        },
        { "id": "limit", "options": { "limitField": 1 } },
        { "id": "organize", "options": { "excludeByName": { "timestamp": true, "backend_status": true }, "renameByName": { "frontend_status": "Frontend" } } }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "up": { "text": "UP", "color": "green" }, "down": { "text": "DOWN", "color": "red" } } }
          ]
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["uptime", "health"],
  "time": { "from": "2026-05-01", "to": "now" }
}
