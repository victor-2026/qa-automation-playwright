{
  "name": "qa-automation-sandbox",
  "version": "1.0.0",
  "description": "**A free, open-source, full-stack social network designed specifically as a practice environment for QA automation engineers.**",
  "main": "index.js",
  "scripts": {
    "build": "set -ex; cd frontend && npm ci --no-audit --no-fund && npm run build && cd .. && mkdir -p dist && cp -r frontend/dist/. dist/ && cp frontend/nginx.conf nginx.conf && ls -la dist/ nginx.conf",
    "start": "echo 'See backend/ and frontend/ for service entry points' && exit 0",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:smoke": "npx playwright test e2e/smoke.spec.ts --project=chromium",
    "test:pbt": "jest --config=jest.config.ts",
    "test:db": "jest --config=jest.config.ts --testPathPattern=db",
    "test:allure": "playwright test && npx allure generate allure-results --clean && npx allure open",
    "test:python": "pytest python/tests/ -v",
    "test:go": "go test -v ./go/...",
    "test:k6": "k6 run k6/api-load-test.js",
    "test:k6:quick": "k6 run -e QUICK=true k6/api-load-test.js",
    "test:load:smoke": "npx playwright test e2e/load/smoke-load.spec.ts --project=chromium",
    "test:load:basic": "npx playwright test e2e/load/basic-load.spec.ts --project=chromium",
    "test:load:stress": "npx playwright test e2e/load/stress-load.spec.ts --project=chromium",
    "test:load:network": "npx playwright test e2e/load/network-fail.spec.ts --project=chromium",
    "test:load:all": "npx playwright test e2e/load/",
    "test:daily": "npm run test:smoke && npm run test:load:all",
    "contracts:export": "npx tsx contracts/export-spec.ts",
    "contracts:validate": "npx playwright test --project=contracts",
    "contracts:all": "npm run contracts:export && npm run contracts:validate",
    "test:pact:consumer": "rm -f contracts/pacts/*.json && npx tsx contracts/consumers/auth.pact.spec.ts && npx tsx contracts/consumers/posts.pact.spec.ts",
    "test:pact:provider": "npx tsx contracts/provider/auth-verification.spec.ts && npx tsx contracts/provider/posts-verification.spec.ts",
    "test:pact:all": "npm run test:pact:consumer && npm run test:pact:provider",
    "lint": "eslint e2e/ pbt/ db/ contracts/ --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manikosto/qa-automation-sandbox.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/manikosto/qa-automation-sandbox/issues"
  },
  "homepage": "https://github.com/manikosto/qa-automation-sandbox#readme",
  "devDependencies": {
    "@fast-check/jest": "^2.2.0",
    "@pact-foundation/pact": "^16.5.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "allure-commandline": "^2.42.0",
    "allure-playwright": "^3.9.0",
    "eslint": "^8.57.0",
    "fast-check": "^4.6.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.4.1",
    "pg": "^8.20.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2"
  }
}
